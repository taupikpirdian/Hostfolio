APP_NAME=Hostfolio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Jakarta
TRUSTED_PROXIES=
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

# Docker publishes localhost only. Put an HTTPS reverse proxy in front of it.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
# Use false only for local HTTP testing; production HTTPS requires true.
SESSION_SECURE_COOKIE=true

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info
BCRYPT_ROUNDS=12

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hostfolio
DB_USERNAME=hostfolio
# Set unique random passwords before using Docker Compose.
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MINIO_ACCESS_KEY_ID=
MINIO_SECRET_ACCESS_KEY=
MINIO_DEFAULT_REGION=us-east-1
MINIO_BUCKET=polres-tasikmalaya
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_URL=http://127.0.0.1:9000/polres-tasikmalaya
MINIO_USE_PATH_STYLE_ENDPOINT=true
# Gambar MinIO disajikan melalui endpoint proxy /images milik Laravel.
MINIO_VISIBILITY=public

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=hostfolio@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Daily database dump at 02:00 Asia/Jakarta, retaining 14 days.
BACKUP_PATH=./storage/backups
BACKUP_RETENTION_DAYS=14
BACKUP_HOUR=2
# Mount a directory backed by another machine/storage before enabling.
BACKUP_OFFSITE_ENABLED=false
BACKUP_OFFSITE_PATH=./storage/backup-offsite

VITE_APP_NAME="${APP_NAME}"
