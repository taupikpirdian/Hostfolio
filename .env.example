APP_NAME="Polres Tasikmalaya"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
GOOGLE_ANALYTICS_ID=G-65244090XY
APP_PORT=8080
APP_TIMEZONE=Asia/Jakarta
PUBLIC_SERVICES_ENABLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Koneksi MySQL lokal. Untuk PostgreSQL gunakan pgsql dan port 5432.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=polres_tasikmalaya
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Gunakan "minio" untuk object storage atau "public" untuk storage lokal.
IMAGE_STORAGE_DISK=public
IMAGE_TEMPORARY_URL_TTL_MINUTES=15
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CACHE_DB=1

# Satu view per pengunjung dan konten dalam rentang TTL ini (default 24 jam).
CONTENT_VIEW_DEDUP_STORE=redis
CONTENT_VIEW_DEDUP_TTL_SECONDS=86400
CONTENT_VIEW_DEDUP_PREFIX=content-view

TURNSTILE_ENABLED=true
# Untuk localhost dapat memakai testing keys resmi Cloudflare; gunakan keys asli di production.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Isi hostname saja tanpa skema, contoh: www.example.go.id
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_TIMEOUT_SECONDS=5

# GOWA (go-whatsapp-web-multidevice) REST API.
GOWA_ENABLED=false
GOWA_MOCK=false
GOWA_URL=http://127.0.0.1:3000
GOWA_BASIC_AUTH_TOKEN=
GOWA_USERNAME=
GOWA_PASSWORD=
# Wajib diisi jika GOWA menggunakan multi-device.
GOWA_DEVICE_ID=
GOWA_TIMEOUT_SECONDS=10
GOWA_CONNECT_TIMEOUT_SECONDS=3

# Pengingat aktivitas perkara yang terlambat melebihi batas ini dibatalkan.
CASE_REMINDER_MAX_LATENESS_MINUTES=60

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

MINIO_ACCESS_KEY_ID=
MINIO_SECRET_ACCESS_KEY=
MINIO_DEFAULT_REGION=us-east-1
MINIO_BUCKET=polres-tasikmalaya
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_URL=http://127.0.0.1:9000/polres-tasikmalaya
MINIO_USE_PATH_STYLE_ENDPOINT=true
# Gambar MinIO disajikan melalui endpoint proxy /images milik Laravel.
MINIO_VISIBILITY=public

VITE_APP_NAME="${APP_NAME}"
